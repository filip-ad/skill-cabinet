{
  "name": "skill-cabinet",
  "version": "1.0.0",
  "description": "Read-only private dashboard for governed agent skill snapshots.",
  "type": "module",
  "bin": {
    "skill-cabinet": "bin/skill-cabinet.js",
    "skill-usage": "bin/skill-usage.js",
    "skill-snapshot": "bin/skill-snapshot.js"
  },
  "files": [
    "bin",
    "dist",
    "scripts",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node bin/skill-cabinet.js",
    "test": "node --test server/*.test.js src/*.test.js",
    "prepare": "node scripts/ensure-dist.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filip-ad/skill-cabinet.git"
  },
  "homepage": "https://github.com/filip-ad/skill-cabinet#readme",
  "bugs": {
    "url": "https://github.com/filip-ad/skill-cabinet/issues"
  },
  "keywords": [
    "skills",
    "claude",
    "cursor",
    "codex",
    "agents",
    "npx"
  ],
  "author": "subsy",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.1.5"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
